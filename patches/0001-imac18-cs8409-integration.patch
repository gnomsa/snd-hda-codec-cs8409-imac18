+[Unit]
+Description=Select the iMac18,3 CS8409 analog PipeWire output
+After=pipewire-pulse.service
+Wants=pipewire-pulse.service
+PartOf=pipewire-pulse.service
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/libexec/cs8409-imac18/select-analog-output.sh
+TimeoutStartSec=25
+
+[Install]
+WantedBy=pipewire-pulse.service
